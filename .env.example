# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: SQLite
DATABASE_URL="file:./prisma/dev.db"
# Production (Supabase): uncomment and fill in
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-char-secret"
NEXTAUTH_URL="http://localhost:3001"

# ── Anthropic API (AI chat assistant) ─────────────────────────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY="REPLACE_WITH_YOUR_KEY"

# ── Resend (transactional email) ──────────────────────────────────────────────
# Get your key at: https://resend.com — free tier: 3,000 emails/month
RESEND_API_KEY="REPLACE_WITH_YOUR_KEY"
