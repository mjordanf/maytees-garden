# ── Phase Flags ───────────────────────────────────────────────────────────────
# 1 = static marketing site only (Phase 1 launch), 2 = full app (all features)
NEXT_PUBLIC_PHASE=1

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: Docker PostgreSQL
DATABASE_URL="postgresql://maytee:maytee@localhost:5432/maytees?schema=public"
# Production (Neon): use the pooler URL from console.neon.tech
# DATABASE_URL="postgresql://neondb_owner:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-char-secret"
NEXTAUTH_URL="http://localhost:3001"

# ── Anthropic API (AI chat assistant) ─────────────────────────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY="REPLACE_WITH_YOUR_KEY"

# ── Resend (transactional email) ──────────────────────────────────────────────
# Get your key at: https://resend.com — free tier: 3,000 emails/month
RESEND_API_KEY="REPLACE_WITH_YOUR_KEY"
RESEND_FROM_EMAIL="noreply@mayteesgardencenter.com"

# ── Square (payments) ─────────────────────────────────────────────────────────
# Get your keys at: https://developer.squareup.com
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_LOCATION_ID=
# For Square Web Payments SDK (client-side — must be NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
# Controls which credentials are used — set to "sandbox" for testing, "production" for live
# NOTE: NODE_ENV is always "production" on Vercel, so this must be set explicitly
SQUARE_ENVIRONMENT=sandbox
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox

# ── Shippo (shipping labels) ───────────────────────────────────────────────────
# Get your key at: https://goshippo.com
SHIPPO_API_KEY=

# ── Business Info ─────────────────────────────────────────────────────────────
BUSINESS_PHONE=7862276616
ADMIN_EMAIL=info@mayteesgardencenter.com

# ── Microsoft Graph (calendar sync) ──────────────────────────────────────────
# See src/lib/microsoft-graph.ts for setup instructions
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALENDAR_USER=info@mayteesgardencenter.com

# ── Cron (reminder emails) ────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
CRON_SECRET=
